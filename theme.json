{
  "name": "Slate",
  "author": "rrambul",
  "version": "v0.5.0",
  "description": "A minimal, clean Gaming Mode theme: neutral charcoal, rounded shapes and calm Slate accents. The games are the artwork; the interface disappears.",
  "target": "System-Wide",
  "manifest_version": 9,
  "inject": {
    "css/tokens.css": [
      "bigpicture",
      "MainMenu",
      "QuickAccess",
      "notificationtoasts_.*",
      "store"
    ],
    "css/canvas.css": [
      "bigpicture"
    ],
    "css/home.css": [
      "bigpicture"
    ],
    "css/library.css": [
      "bigpicture"
    ],
    "css/gamepage.css": [
      "bigpicture"
    ],
    "css/settings.css": [
      "bigpicture",
      "MainMenu"
    ],
    "css/downloads.css": [
      "bigpicture"
    ],
    "css/store.css": [
      "store"
    ],
    "css/search.css": [
      "bigpicture"
    ],
    "css/media.css": [
      "bigpicture"
    ],
    "css/contextmenu.css": [
      "bigpicture"
    ],
    "css/plugins.css": [
      "bigpicture"
    ],
    "css/mainmenu.css": [
      "MainMenu"
    ],
    "css/quickaccess.css": [
      "QuickAccess"
    ],
    "css/accents.css": [
      "bigpicture",
      "MainMenu",
      "QuickAccess"
    ],
    "css/notifications.css": [
      "bigpicture",
      "QuickAccess",
      "notificationtoasts_.*"
    ]
  },
  "patches": {
    "Hero": {
      "type": "dropdown",
      "default": "Full",
      "values": {
        "Full": {
          "css/hero-full.css": [
            "bigpicture"
          ]
        },
        "Compact": {}
      }
    },
    "Keyboard": {
      "type": "dropdown",
      "default": "Slate",
      "values": {
        "Slate": {
          "css/keyboard.css": [
            "bigpicture"
          ]
        },
        "Steam": {}
      }
    }
  }
}
